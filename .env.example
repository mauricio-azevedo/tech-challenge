# Copie para .env antes de subir os servicos: cp .env.example .env

# ---- Banco de dados ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=challenge
# Porta exposta no host (mude se ja houver um Postgres local em 5432; ajuste DATABASE_URL junto)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/challenge?schema=public

# ---- Kafka ----
KAFKA_BROKERS=localhost:9092
# Um client id por servico: e o que aparece no Kafka UI e nos logs do broker
KAFKA_CLIENT_ID_TRANSACTIONS=transactions
KAFKA_CLIENT_ID_ANTI_FRAUD=anti-fraud
KAFKA_GROUP_ID_TRANSACTIONS=transactions-consumer
KAFKA_GROUP_ID_ANTI_FRAUD=anti-fraud-consumer
# Particoes dos topicos de negocio (criados no boot); DLQs tem 1
KAFKA_TOPIC_PARTITIONS=3

# ---- Outbox (servico de transacoes) ----
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_CLAIM_TIMEOUT_MS=30000

# ---- Portas das aplicacoes ----
TRANSACTIONS_PORT=3001
ANTI_FRAUD_PORT=3002

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001
