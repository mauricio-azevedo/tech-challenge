{
  "name": "tech-challenge",
  "private": true,
  "description": "Desafio tecnico BIUD: transacoes financeiras com validacao antifraude orientada a eventos",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @challenge/transactions db:migrate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bootstrap": "turbo run db:generate && turbo run build --filter=./packages/*",
    "quality": "pnpm bootstrap && pnpm lint && pnpm format:check && turbo run typecheck test build",
    "smoke": "tsx scripts/smoke.ts",
    "prepare": "husky && pnpm bootstrap"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "catalog:",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "typescript-eslint": "^8.68.0"
  }
}
