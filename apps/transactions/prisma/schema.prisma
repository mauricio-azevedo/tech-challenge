generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Ciclo de vida de uma transacao: nasce PENDING e termina em APPROVED ou REJECTED.
enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("transaction_status")
}

/// Tipos de transferencia aceitos (`transferTypeId` no contrato). Semeados pela migration.
model TransactionType {
  id           Int           @id @db.SmallInt
  name         String        @unique
  transactions Transaction[]

  @@map("transaction_types")
}

model Transaction {
  /// UUID v7: ordenavel no tempo, evita a fragmentacao de indice do v4 em tabelas append-only.
  id                      String            @id @default(uuid(7)) @db.Uuid
  accountExternalIdDebit  String            @map("account_external_id_debit") @db.Uuid
  accountExternalIdCredit String            @map("account_external_id_credit") @db.Uuid
  transactionTypeId       Int               @map("transaction_type_id") @db.SmallInt
  transactionType         TransactionType   @relation(fields: [transactionTypeId], references: [id])
  status                  TransactionStatus @default(PENDING)
  /// Dinheiro e decimal exato, nunca ponto flutuante.
  value                   Decimal           @db.Decimal(15, 2)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Indices cobrindo os filtros da listagem, sempre ordenada por data decrescente.
  @@index([status, createdAt(sort: Desc)])
  @@index([transactionTypeId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("transactions")
}

/// Transactional outbox: o evento e gravado na mesma transacao do dado que o originou e
/// publicado no Kafka depois, por um relay. Broker fora do ar nao perde evento nem bloqueia a API.
model OutboxEvent {
  /// Mesmo valor do `eventId` do envelope: a linha e o evento.
  id          String    @id @db.Uuid
  topic       String
  /// Chave da mensagem Kafka (id da transacao): ordem garantida por agregado.
  key         String
  payload     Json
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(6)

  // O relay le "nao publicados, mais antigos primeiro"; nulos sao indexados no Postgres.
  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
